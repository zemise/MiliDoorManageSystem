# 复制此文件为 .env 并填入实际值
# cp .env.example .env

# ── 必填 ──────────────────────────────────────────────
MQTT_HOST=
MQTT_TOPIC_PREFIX=

# ── MQTT（可选）────────────────────────────────────────
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_EVENT_SUFFIX=event
MQTT_INCOMING_CALL_REPEAT_S=1

# ── 门禁 IP 映射（按需填写）───────────────────────────
DOOR_IP_1=
DOOR_IP_2=
DOOR_IP_3=
DOOR_IP_4=

# ── RTSP（可选）────────────────────────────────────────
RTSP_HOST=            # HA 可访问的荔枝派 IP
RTSP_BACKEND=light    # light 或 gstreamer，不可同时启用
RTSP_VIDEO_PORT=8554
RTSP_AUDIO_PORT=8555
RTSP_VIDEO_MOUNT=/video
RTSP_AUDIO_MOUNT=/audio

# ── 本地 I/O（可选）───────────────────────────────────
# BELL_WAV_PATH=      # 留空则自动查找 门铃.wav
BELL_DEVICE=hw:0,0
GPIO_READ_PIN=2
BUTTON_PRESSED_LEVEL=0

# ── 超时（可选）────────────────────────────────────────
RINGING_TIMEOUT_S=45
ACTIVE_TIMEOUT_S=20

# ── 高级（可选）────────────────────────────────────────
UDP_PORT=14301
