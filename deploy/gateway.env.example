# 板端运行配置模板
# 复制为 gateway.env 并填写实际值：
#   cp gateway.env.example gateway.env
#
# 推荐方案：使用 Home Assistant 的 Mosquitto Broker。
# MQTT_HOST 填 HA/Mosquitto 在家庭局域网中的地址。

# ── MQTT（必填）─────────────────────────────────────
MQTT_HOST=
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=mili/door
MQTT_EVENT_SUFFIX=event
MQTT_INCOMING_CALL_REPEAT_S=1

# ── 门禁 IP 映射（现场实测：DOOR_IP_1= 有效）──
DOOR_IP_1=
DOOR_IP_2=
DOOR_IP_3=
DOOR_IP_4=

# ── RTSP（HA 必须能访问 RTSP_HOST）──
RTSP_HOST=
RTSP_BACKEND=light
RTSP_VIDEO_PORT=8554
RTSP_AUDIO_PORT=8555
RTSP_VIDEO_MOUNT=/video
RTSP_AUDIO_MOUNT=/audio

# ── 本地 I/O（可选；LicheeRV Nano 上 GPIO 尚未适配，先保持默认）──
# BELL_WAV_PATH=
BELL_DEVICE=hw:0,0
GPIO_READ_PIN=2
BUTTON_PRESSED_LEVEL=0

# ── 超时（可选）────────────────────────────────────────
RINGING_TIMEOUT_S=45
ACTIVE_TIMEOUT_S=20

# ── 高级（可选）────────────────────────────────────────
UDP_PORT=14301

# 仅在兼容旧部署时开启板端 aMQTT；HA 接入推荐保持 0。
LOCAL_MQTT_BROKER=0
