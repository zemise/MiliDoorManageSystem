# 板端运行配置模板
# 复制为 gateway.env 并填写实际值：
#   cp gateway.env.example gateway.env
#
# 当前方案：broker 跑在板子本地，因此 MQTT_HOST=127.0.0.1。
# 如果以后 broker 迁到 PVE/有线设备，改 MQTT_HOST 即可。

# ── MQTT（必填）─────────────────────────────────────
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=mili/door
MQTT_EVENT_SUFFIX=event
MQTT_INCOMING_CALL_REPEAT_S=1

# ── 门禁 IP 映射（现场实测：DOOR_IP_1= 有效）──
DOOR_IP_1=
DOOR_IP_2=
DOOR_IP_3=
DOOR_IP_4=

# ── RTSP（可选，需 GStreamer；APP 不在同一网段时填板子可达 IP）──
# RTSP_HOST=
RTSP_VIDEO_PORT=8554
RTSP_AUDIO_PORT=8555
RTSP_VIDEO_MOUNT=/video
RTSP_AUDIO_MOUNT=/audio

# ── 本地 I/O（可选；LicheeRV Nano 上 GPIO 尚未适配，先保持默认）──
# BELL_WAV_PATH=
BELL_DEVICE=hw:0,0
GPIO_READ_PIN=2
BUTTON_PRESSED_LEVEL=0

# ── 超时（可选）────────────────────────────────────────
RINGING_TIMEOUT_S=45
ACTIVE_TIMEOUT_S=20

# ── 高级（可选）────────────────────────────────────────
UDP_PORT=14301
