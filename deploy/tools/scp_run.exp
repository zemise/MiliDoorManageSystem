#!/usr/bin/expect -f
# 通过 SCP 向板端拷贝文件（避免交互输密码）。
# 用法: scp_run.exp <src> <ip> <user> <password> <dst>
# 可选: SSH_PORT=1124 scp_run.exp ...
set timeout 120
set src  [lindex $argv 0]
set ip   [lindex $argv 1]
set user [lindex $argv 2]
set pass [lindex $argv 3]
set dst  [lindex $argv 4]
set port 22
if {[info exists env(SSH_PORT)] && $env(SSH_PORT) ne ""} {
    set port $env(SSH_PORT)
}

spawn scp -P $port -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ConnectTimeout=5 $src $user@$ip:$dst
expect {
    -re "(?i)password:" { send -- "$pass\r"; exp_continue }
    eof
}
catch wait result
exit [lindex $result 3]
