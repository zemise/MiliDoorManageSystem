#!/usr/bin/expect -f
# 通过 SSH 在板端执行命令（避免交互输密码）。
# 用法: ssh_run.exp <ip> <user> <password> <command...>
set timeout 240
set ip     [lindex $argv 0]
set user   [lindex $argv 1]
set pass   [lindex $argv 2]
set cmd    [join [lrange $argv 3 end]]

spawn ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ConnectTimeout=5 -o NumberOfPasswordPrompts=1 $user@$ip $cmd
expect {
    -re "(?i)password:" { send -- "$pass\r"; exp_continue }
    eof
}
catch wait result
exit [lindex $result 3]
